@model System.Collections.Generic.List<PortfolioOrderApp.Domain.OrderLine>

<h1>Orden en curso</h1>

@* lineas agregadas a la orden. *@
<table>
    <tr>
        <th>Ticker</th>
        <th>Operacion</th>
        <th>Cantidad</th>
    </tr>
    @foreach (var line in Model)
    {
        <tr>
            <td>@line.Ticker</td>
            <td>@line.Side</td>
            <td style="text-align: center">@line.Quantity</td>
        </tr>
    }
</table>

<p>Total estimado: @ViewBag.EstimatedTotal.ToString("C")</p>

@* confirmar si hay lineas. *@
@if (Model.Count > 0)
{
    using (Html.BeginForm("Confirm", "OrderTicket", FormMethod.Post))
    {
        <button type="submit">Confirmar orden</button>
    }
}

<p>@Html.ActionLink("Volver al catalogo", "Index", "Instruments")</p>
